Screen {
    background: $surface;
}

#body {
    height: 1fr;
    padding: 0 2;
}

#home {
    width: 1fr;
    height: 1fr;
    border: round $primary-darken-1;
    background: $panel-darken-1;
    overflow-x: auto;
}

#room-grid {
    layout: grid;
    grid-gutter: 1;
    width: 1fr;
    height: 1fr;
}

.room-panel {
    width: 100%;
    min-width: 22;
    height: 100%;
    border: round $primary-darken-1;
    background: $panel;
    border-title-color: $text;
    border-title-style: bold;
    padding: 0 1;
}

.device-row {
    height: auto;
    width: 100%;
}

.device-line {
    width: 1fr;
    height: auto;
    align: left middle;
}

.device-icon {
    width: 3;
    height: 3;
    content-align: center middle;
    color: $text-muted;
    text-style: bold;
}

.device-icon.notable {
    color: $warning;
}

.device-info {
    width: 1fr;
    height: auto;
    padding-left: 1;
}

.device-name {
    width: 100%;
    color: $text-muted;
}

.device-switch {
    border: round $primary-darken-1;
    padding: 0;
}

#controls {
    width: 30;
    height: 1fr;
}

#log-label {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

#log {
    height: 1fr;
    border: round $primary-darken-1;
    background: $panel-darken-1;
    margin-bottom: 1;
}

#chat {
    width: 36;
    height: 1fr;
}

#chat-label {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

#chat-log {
    height: 1fr;
    border: round $primary-darken-1;
    background: $panel-darken-1;
    margin-bottom: 1;
}

#chat-input {
    border: round $primary-darken-1;
}
